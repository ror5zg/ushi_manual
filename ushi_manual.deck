{module:wigglyBrushes}
description:"brushes used by the wigglyModal contraption."
version:1
{script}
stipples:"%J" parse "[
 %%IMG0AAQABAAwMAA=,
 %%IMG0AAQABMDAAAA=,
 %%IMG0AAQABAAAYGA=,
 %%IMG0AAQABADAwAA=,
 %%IMG0AAQABIAAAIA=,
 %%IMG0AAQABAAgAEA=,
 %%IMG0AAQABEAAEAA=,
 %%IMG0AAQABAAAgBA=,
]"
brush[on stipple do random[stipples] end]

softlarge:each t in data:"%j" parse "[
  [[ 5, 1],[ 4,10],[ 9,10],[10, 1]],[[12, 2],[ 8,13],[ 7,14],[ 4,13]],[[ 4, 9],[ 7,10],[12, 9],[14, 4]],[[ 4, 3],[ 9, 2],[ 9, 8],[ 6, 8]],
  [[13, 9],[ 7, 9],[13, 5],[11, 9]],[[10,12],[ 8, 3],[11, 7],[ 3, 7]],[[ 1, 9],[ 6, 2],[ 4,12],[ 3, 6]],[[ 5,14],[ 8,14],[11,12],[15, 5]],
  [[ 1, 3],[11, 1],[ 3, 4],[ 2, 5]],[[ 3,11],[ 5, 4],[10, 3],[ 0, 8]],[[14, 9],[11, 5],[10, 8],[ 8, 4]],[[11, 2],[10, 0],[ 2,10],[11,14]],
  [[ 5, 7],[14, 5],[ 0, 9],[ 4, 2]],[[ 1, 7],[13, 4],[ 2, 3],[13, 3]],[[ 3,14],[ 3,10],[ 7, 4],[12, 8]],[[ 6, 0],[ 3, 9],[ 1, 8],[12, 7]],
  [[ 4,14],[14,10],[ 5, 0],[ 9, 3]],[[14, 3],[ 3,12],[11, 3],[ 9, 1]],[[ 3, 3],[13, 6],[ 2,12],[ 7, 6]],[[ 3, 2],[11, 8],[ 4, 8],[ 8, 0]],
  [[ 7, 2],[ 2, 4],[ 8,11],[12,10]],[[ 8, 1],[ 9, 7],[ 8,12],[13, 7]],[[15, 7],[13, 8],[10,11],[ 2, 2]],[[ 6, 1],[ 8, 6],[ 8, 7],[ 0, 6]],
  [[ 4, 4],[10, 2],[ 4, 1],[ 4, 5]],[[ 5, 2],[ 6,10],[14, 6],[ 9, 4]],[[ 5, 5],[10, 6],[ 5, 3],[ 7,13]],[[12,13],[ 3, 1],[14, 8],[ 5,12]],
  [[ 5,15],[ 8,15],[11, 6],[12,11]],[[ 3, 8],[12,14],[ 6, 9],[ 6, 5]],[[ 0, 7],[ 3, 5],[ 7,11],[ 1, 6]],[[ 6, 7],[ 4, 6],[12, 6],[ 2,11]],
  [[13, 2],[ 6, 3],[10, 9],[10, 4]],[[ 6,15],[ 8, 9],[13,10],[ 8, 8]],[[ 8, 5],[10, 5],[ 5,11],[15, 6]],[[ 4, 7],[ 0,10],[ 8, 2],[10,13]],
  [[11, 4],[13,11],[14,11],[ 5,10]],[[12, 1],[ 7, 7],[14, 7],[14,12]],[[ 6,11],[ 5, 9],[ 3,13],[ 9,13]],[[ 7, 8],[10,10],[ 7, 3],[ 7,15]],
  [[ 9,11],[ 6, 6],[ 4,11],[ 2,13]],[[ 7,12],[11,11],[ 9,14],[ 7, 1]],[[15,10],[ 2, 8],[ 1, 5],[ 9, 0]],[[15, 8],[10,14],[10, 7],[ 9,12]],
  [[ 1,10],[ 9, 5],[15, 9],[ 1,11]],[[ 0, 5],[ 6,14],[ 1, 4],[ 7, 5]],[[ 1,12],[ 9,15],[10,15],[ 5, 8]],[[ 5, 6],[12,12],[11,10],[12, 3]],
  [[ 9, 6],[ 6,12],[ 7, 0],[12, 5]],[[11,13],[ 8,10],[ 2, 7],[ 6,13]],[[13,13],[ 9, 9],[ 2, 9],[12, 4]],[[ 5,13],[13,12],[ 2, 6],[ 6, 4]]
 ]"
 i:image[16,16] each v in t i[v]:1 end i
end
brush[on airbrush do random[softlarge] end]

sumis:"%J" parse "[
 %%IMG0AA0ADQ+AP+B/8H/w//j/+P/4//j/+H/wf/A/4A+A,
 %%IMG0AAwADB+AP8B/4P/w//D/8P/w//D/8H/gP8AfgA==,
 %%IMG0AAsACx8AP4B/wP/g/+D/4P/g/+B/wD+AHwA=,
 %%IMG0AAoACh4Af4B/gP/A/8D/wP/Af4B/gB4A,
 %%IMG0AAkACT4AfwD/gP+A/4D/gP+AfwA+AA==,
 %%IMG0AAgACDx+/////348,
 %%IMG0AAcAB3z+/v7+/nw=,
 %%IMG0AAcABzh8/v7+fDg=,
 %%IMG0AAYABnj8/Pz8eA==,
 %%IMG0AAYABjB4/Px4MA==,
 %%IMG0AAUABXD4+Phw,
 %%IMG0AAQABGDw8GA=,
 %%IMG0AAMAA+Dg4A==,
 %%IMG0AAMAA0DgQA==,
 %%IMG0AAIAAsDA,
 %%IMG0AAEAAYA=,
]"
brush[on sumi delta do sumis[ 5+9&.5*mag delta]end]

brush["eraser" image[11,11].map[() 1]]
{end}

{module:dd}
description:"Display sequential, styled modal dialogs for visual novels."
version:1.7
{script}
# state/constants:
local host:0
local canvas:0
local padding:10
local margin:20
local arrow:image["%%IMG0AAsABv/gf8A/gB8ADgAEAA=="]
local arrow_anim:arrow,image[arrow.size]

# config:
local tfont:"body"
local bfont:"body"
local align:"left"
local balign:"center"
local fcolor:32
local bcolor:1
local next:arrow_anim
local nextd:10
local speed:0
local names:() dict ()
local border:0
local bborder:0
local pad:()
local bpad:()
local osound:"" # open box
local nsound:"" # advance to next box
local asound:"" # make a choice
local tsound:"" # talk
local dsize:()
local dpos:0

on ifmt x do x format names end
on fmt x do update text:ifmt @ text from rtext.cat[x] end
on tween a b t do a+(b-a)*0|1&t end
on rin x pos size do min(x>pos),(x<pos+size) end
on tick do host.card.event["animate"] sleep[] end

on sfx x do
 play[if "list"~typeof x random[x] else x end]
end

on draw_border do
 canvas.clear[]
 if border.type~"image"
  canvas.segment[border 0,0,canvas.size (range pad)]
 else
  canvas.pattern:bcolor
  canvas.rect[0,0 canvas.size]
  canvas.pattern:fcolor
  canvas.box[0,0 canvas.size]
 end
end

on repos pos size do
 if dpos~"center"
  .5*host.card.size-size
 elseif dpos in host.card.widgets
  t:host.card.widgets[dpos]
  t.pos+.5*t.size-size
 else pos
 end
end

on resize height do
 cs0:canvas.size
 cs1:((host.card.size[0]-2*margin) unless dsize[0]),height
 cp0:canvas.pos
 cp1:repos[(.5*host.card.size[0]-cs1[0]),host.card.size[1]-cs1[1]+margin cs1]
 each t in .2*range 6
  canvas.size:tween[cs0 cs1 t]
  canvas.pos :tween[cp0 cp1 t]
  draw_border[]
  tick[]
 end
end

module.open:on open deck etc do
 if canvas & canvas.show~"transparent" close[] end
 host:deck
 canvas:host.card.widgets.dd_overlay
 if !canvas canvas:host.card.add["canvas" "dd_overlay"] end
 style[etc]
 canvas.size:((host.card.size[0]-2*margin) unless dsize[0]),0
 canvas.pos:repos[(.5*host.card.size[0]-canvas.size[0]),host.card.size[1]-margin canvas.size]
 canvas.show:"transparent"
 canvas.border:0
 sfx[osound]
end

module.style:on style etc do
 fcolor:if "fcolor" in etc etc.fcolor else 32         end
 bcolor:if "bcolor" in etc etc.bcolor else 1          end
 tfont :if "tfont"  in etc etc.tfont  else "body"     end
 bfont :if "bfont"  in etc etc.bfont  else "body"     end
 align :if "align"  in etc etc.align  else "left"     end
 balign:if "balign" in etc etc.balign else "center"   end
 names :if "names"  in etc etc.names  else ()dict()   end
 next  :if "next"   in etc etc.next   else arrow_anim end
 nextd :if "nextd"  in etc etc.nextd  else 10         end
 speed :if "speed"  in etc etc.speed  else 0          end
 osound:if "osound" in etc etc.osound else ""         end
 nsound:if "nsound" in etc etc.nsound else ""         end
 asound:if "asound" in etc etc.asound else ""         end
 tsound:if "tsound" in etc etc.tsound else ""         end
 dsize: if "size"   in etc etc.size   else ()         end
 dpos:  if "pos"    in etc etc.pos    else 0          end
 if !dsize[0] dsize[0]:nil end
 if !dsize[1] dsize[1]:nil end
 border:etc.border.image.copy[]
 pad:"ltrb" dict 4 take padding unless etc.border.margin
 bborder:etc.bborder.image.copy[]
 bpad:"ltrb" dict 4 take (2,10,2,10) unless etc.bborder.margin
 if balign~"left"  balign:"center_left"  end
 if balign~"right" balign:"center_right" end
 if "image"~typeof next next:next,image[next.size] end
 if (()~next)|(!"list"~typeof next) next:arrow_anim end
 if 1~count next next:next,image[next.size] end
 nextd:1|nextd
end

module.getstyle:on getstyle do
 raze insert k v with
  "fcolor"  fcolor
  "bcolor"  bcolor
  "tfont"   tfont
  "bfont"   bfont
  "align"   align
  "balign"  (("center_left","center_right","center") dict ("left","right","center"))[balign]
  "names"   names
  "next"    next
  "nextd"   nextd
  "speed"   speed
  "osound"  osound
  "nsound"  nsound
  "asound"  asound
  "tsound"  tsound
  "size"    dsize
  "pos"     dpos
  "border"  (("image","margin")dict((list  border),(list range  pad)))
  "bborder" (("image","margin")dict((list bborder),(list range bpad)))
 end
end

module.show:on show x do
 canvas.toggle["transparent" x]
end

module.close:on close do
 if canvas & canvas.show~"transparent" resize[0] end
 host.card.remove[canvas]
 host:canvas:0
end

module.say:on say text do
 text:fmt @ rtext.split["\n\n" text]
 canvas.font:tfont
 each seg i in text
  t:rtext.string[seg]
  if t[0]~"!"
   host.card.event["command" (1 drop t)]
  else
   dim:canvas.textsize[seg (canvas.size[0] unless dsize[0])-(pad.l+pad.r)]
   szh:dim[1]+(pad.t+pad.b)+next.size[1]
   if dsize[0] dim[0]:dsize[0]-pad.l+pad.r end
   resize[szh unless dsize[1]]
   canvas.pattern:fcolor
   if speed
    host.modules.pt.value.talk[1]
    splits: extract index,1+count t where value in (" ","\n") from "" split t
    si:0 db:0 while si<count splits
     sfx[tsound]
     each in range speed
      if pointer.down si:-1+count splits db:1 end
      tick[]
     end
     draw_border[]
     canvas.pattern:fcolor
     canvas.text[rtext.span[seg 0,splits[si]] pad.l,pad.t,dim ("top_%s" format align)]
     si:si+1
    end
    host.modules.pt.value.talk[0]
    if db
     while pointer.held|pointer.down tick[] end
    end
   else
    canvas.text[seg pad.l,pad.t,dim ("top_%s" format align)]
   end
   ns:next..copy[].map[(0,1) dict bcolor,fcolor]
   on wait do
    a:ns[(count ns)%floor sys.frame/nextd]
    canvas.paste[a canvas.size-(pad.r,pad.b)+a.size]
    tick[]
   end
   while !pointer.held|pointer.down wait[] end
   sfx[nsound]
   while  pointer.held|pointer.up   wait[] end
  end
 end
end

module.ask:on ask text choices do
 seg:fmt[text]
 canvas.font:tfont
 dim:canvas.textsize[seg (canvas.size[0] unless dsize[0])-(pad.l+pad.r)]
 if 1>count choices choices:list "error: empty choice list for dd.ask!" end
 segs:fmt @ choices
 canvas.font:bfont
 dims:each choice in segs
  canvas.textsize[choice (canvas.size[0] unless dsize[0])-(bpad.t+bpad.b)+(pad.t+pad.b)][1]+(bpad.t+bpad.b)
 end
 szh:dim[1]+(pad.t+pad.b)+(sum dims)+(padding*count dims)
 if dsize[0] dim[0]:dsize[0]-pad.l+pad.r end
 resize[szh unless dsize[1]]
 local r:-1 while -1~r
  draw_border[]
  canvas.font:tfont
  canvas.pattern:fcolor
  canvas.text[seg (pad.l,pad.t),dim ("top_%s" format align)]
  c:dim[1]+pad.t+padding
  ow:canvas.size[0]-(pad.l+pad.r)
  each choice i in segs
   local rpos:pad.l,c
   local rsize:ow,dims[i]
   local tpos:rpos+bpad.l,bpad.t
   local tsize:rsize-((bpad.l+bpad.r),(bpad.t+bpad.b))
   # active background (invert label)
   canvas.pattern:fcolor
   if (pointer.held|pointer.down|pointer.up)&rin[pointer.pos-canvas.pos rpos rsize]
    if bborder.type~"image"
     canvas.rect[rpos rsize]
    else
     canvas.rect[rpos+2 rsize-4]
    end
    if pointer.up r:i sfx[asound] end
    canvas.pattern:bcolor
   end
   # label
   canvas.font:bfont
   canvas.text[choice tpos,tsize balign]
   # border
   if bborder.type~"image"
    canvas.segment[bborder rpos,rsize (range bpad)]
   else
    canvas.pattern:fcolor
    canvas.box[rpos rsize]
   end
   c:c+padding+dims[i]
  end
  tick[]
 end
 r
end

module.chat:on chat text choices do
 r:0
 st:getstyle[]
 while count choices
  k:keys choices
  style[st]
  v:ask[text k]
  vv:choices[k[v]]
  if "number"~typeof vv
   choices:()
   r:vv
  else
   choices:k[v] drop choices
   say[vv]
  end
 end
 r
end
{end}

{contraption:imageEnum}
size:[100,100]
resizable:1
margin:[17,3,18,5]
description:"select from among enumerated image values."
version:1.1
script:"imageEnum.0p"
template:"on change img index do\n \nend"
attributes:{"name":["options"],"label":["Options"],"type":["rich"]}
{widgets}
s:{"type":"slider","size":[100,100],"pos":[0,0],"interval":[0,0],"format":"","style":"compact"}
c:{"type":"canvas","size":[70,96],"pos":[15,2],"locked":1,"border":0,"scale":1}
o:{"type":"field","size":[44,53],"pos":[129,-20],"locked":1,"show":"none"}

{script:imageEnum.0p}
on get_options do o.value end
on set_options x do o.value:x view[] x end
on get_value do o.images[s.value] end
on get_valueIndex do s.value end
on set_valueIndex x do s.value:x view[] x end

on view do
 im:o.images
 i:im[s.value]
 s.interval:0,0|(count im)-1
 s.locked:card.locked
 s.show  :card.show
 c.show  :card.show
 c.clear[]
 c.paste[i .5*c.size-i.size 1]
end

on change do
 card.event["change" get_value[] s.value]
 view[]
end
{end}

{contraption:wigglyPalette}
size:[100,100]
resizable:1
margin:[1,1,1,1]
description:"Choose from a selection of 5-color palettes compatible with other wiggly components."
version:1
script:"wigglyPalette.0p"
template:"on change do\n \nend"
attributes:{"name":[],"label":[],"type":[]}
{widgets}
p:{"type":"grid","size":[100,100],"pos":[0,0],"locked":1,"headers":0,"lines":0,"widths":[0],"format":"ss","value":{"palette":["FFFFFF|000000|FF0097|0097FF|FFFF00","fbbbad|292831|ee8695|4a7a96|333f58","faf5d8|21181b|d8ae8b|cd5f2a|f2ab37","f0eff4|6b61ff|8ecde6|66a1ff|fadda2","f3eded|82939b|fda9a9|96beb1|b9eedc","d1bfb0|392b35|bb474f|486b7f|7a9c96","d8bfd8|74569b|ffb3cb|96fbc7|f7ffae","effafa|0e0e0e|e624af|3df9ea|5433be","eaf0d8|1f1f29|413a42|596070|96a2b3","e2e9e9|232221|cb2f2c|1b96ba|f1be43","ededde|804776|dd8d9a|c7c6c1|c15c80","e3f6d5|873131|ec6f1c|9ce77f|f6ae3c","eabe7b|580a5c|db8951|8d1c7a|b45b27","ffeaff|4c3299|ef833e|99d7d7|ffe17f","ffdae8|480a30|ff80ae|ff327c|b41360","ffe8e1|292b30|ab6c84|613854|ffc4d1","8767bd|000000|fe0094|70b9fb|5f4886","d3d6b2|4c282f|554c80|569bc9|84cec9","fadd93|2e0d20|8f3808|451c1c|cf7a3a","d4e2cc|17152e|e43254|3c566c|84aea4","b9eba7|0c1024|057f8e|0a3354|04c894","fcbbab|000000|b96889|19112b|583163","ecece0|3b3149|d47563|5c6181|ecc197","f6ebc3|4e1826|6b3e3f|8b8571|b8b98a","f6f0f7|12223c|104a7d|45a9ff|f6d76b","cfc420|51244a|f5bb75|36642b|73a527","d6dea5|442252|61433c|807456|adab8e"],"name":["default                 ","twilight 5              ","nicole punk 82          ","capp-5                  ","marumaru gum            ","retrotronic             ","blessing                ","neo-5                   ","ink                     ","theory of 5             ","sashimi                 ","autumn birch            ","pb and j                ","leon soul               ","5 sheep                 ","juliet                  ","neon moon tarot         ","cyber ping pong         ","ru5ty                   ","a blood-steeped corridor","silent five             ","sweetdusk-5             ","+100                    ","woodland 5              ","infinite ikea           ","chaos                   ","cold sands              "]},"row":0}

{script:wigglyPalette.0p}
on view do
 p.show:card.show
 p.font:card.font
end

on click row do
 idx:32,47,36,39,33 # bg, fg, magenta, cyan, yellow
 each color i in "|"split me.rowvalue.palette
  patterns[idx[i]]:"%06H" parse color
 end 
 card.event["change"]
end

{end}

{contraption:wigglyCanvas}
size:[100,100]
resizable:1
margin:[1,1,1,1]
description:"A simple wiggly drawing surface compatible with wigglyPlayer."
version:1.1
script:"wigglyCanvas.0p"
template:"on stroke_start do\n \nend\n\non stroke_end do\n \nend"
attributes:{"name":["border","temp"],"label":["Border","Template Background"],"type":["bool","bool"]}
{widgets}
c:{"type":"canvas","size":[100,100],"pos":[0,0],"animated":1,"volatile":1,"border":1,"brush":1,"scale":1}
fr:{"type":"field","size":[100,20],"pos":[0,-77],"locked":1,"show":"none","value":{"text":["","i","i","i"],"font":["","","",""],"arg":["","%%IMG2AGQAZAD/AP8A/wD/AP8A/wD/AP8A/wD/AP8A/wD/AP8A/wD/AP8A/wD/AP8A/wD/AP8A/wD/AP8A/wD/AP8A/wD/AP8A/wD/AP8A/wD/AP8A/wA3","%%IMG2AGQAZAD/AP8A/wD/AP8A/wD/AP8A/wD/AP8A/wD/AP8A/wD/AP8A/wD/AP8A/wD/AP8A/wD/AP8A/wD/AP8A/wD/AP8A/wD/AP8A/wD/AP8A/wA3","%%IMG2AGQAZAD/AP8A/wD/AP8A/wD/AP8A/wD/AP8A/wD/AP8A/wD/AP8A/wD/AP8A/wD/AP8A/wD/AP8A/wD/AP8A/wD/AP8A/wD/AP8A/wD/AP8A/wA3"]}}
sfx:{"type":"grid","size":[100,31],"pos":[0,-49],"locked":1,"show":"none","format":"ss","value":{"name":["pen1","pen2"],"data":["%%","%%"]}}
tb:{"type":"button","size":[60,20],"pos":[0,148],"locked":1,"show":"none","style":"check"}
cbo:{"type":"button","size":[100,20],"pos":[154,0],"locked":1,"show":"none","style":"check","value":1}
cp:{"type":"field","size":[100,20],"pos":[154,32],"locked":1,"show":"none","style":"plain","value":"1"}
cbr:{"type":"field","size":[100,20],"pos":[154,63],"locked":1,"show":"none","style":"plain","value":"3"}

{script:wigglyCanvas.0p}
on frames do fr.images end
on get_value do
 r.frames:frames[]
 r.order:range count r.frames
 r
end
on set_value x do
 if x.frames fr.images: x.frames end
end

on drag x do
 if !card.locked
  fr:frames[]
  c.pattern:get_pattern[]
  c.brush:get_brush[]
  o:if pointer.down x else pointer.prev-card.offset end
  each f in fr
   c.paste[f]
   c.line[o random[-1,0,1 2]+x]
   f.paste[c.copy[]]
   if tb.value
    f.paste[deck.card.image.copy[card.pos card.size] 0,0 1]
   end
  end
  if !app.playing
   play[sound[random[sfx.value.data]]]
  end
 end
end
on click x do
 if !card.locked
  card.event["stroke_start"]
  drag[x]
 end
end
on release x do
 if !card.locked
  card.event["stroke_end"]
 end
end

on view do
 f:frames[]
 c.border:cbo.value
 c.show:card.show
 c.clear[]
 i:f[(count f)%sys.frame/5]
 i.size:c.size
 c.paste[i]
end

on get_animate do view end
on get_border do cbo.value end
on set_border x do c.border:x cbo.value:c.border end
on get_brush do 0+cbr.text end
on set_brush x do c.brush:x cbr.text:c.brush end
on get_pattern do 0+cp.text end
on set_pattern x do c.pattern:x cp.text:c.pattern end
on get_temp do tb.value end
on set_temp x do tb.value:x end
on get_clear do
 on clear do
  fr.value:raze rtext.cat @ (3 take image[])..copy[]
 end
end
{end}

{contraption:wigglyPlayer}
size:[100,100]
resizable:1
margin:[1,1,1,1]
description:"A viewer and storage location for wiggly animations, which is also suitable as a \"Fancy Puppet\" for use with Puppeteer."
version:1.2
script:"wigglyPlayer.0p"
template:"on click do\n \nend\n\non drag do\n \nend\n\non release do\n \nend"
attributes:{"name":["border","draggable","stretch","frames","order_text"],"label":["Border","Draggable","Stretch to Fit","Frames","Frame Order"],"type":["bool","bool","bool","rich","string"]}
{widgets}
c:{"type":"canvas","size":[100,100],"pos":[0,0],"locked":1,"animated":1,"volatile":1,"script":"wigglyPlayer.1p","border":1,"scale":1}
fr:{"type":"field","size":[100,20],"pos":[0,-77],"locked":1,"show":"none"}
or:{"type":"field","size":[100,20],"pos":[0,-49],"locked":1,"show":"none","style":"plain"}
fl:{"type":"button","size":[60,20],"pos":[0,148],"locked":1,"show":"none","style":"check"}
em:{"type":"field","size":[100,20],"pos":[109,-49],"locked":1,"show":"none","style":"plain"}
cbo:{"type":"button","size":[100,20],"pos":[109,0],"locked":1,"show":"none","style":"check","value":1}
cst:{"type":"button","size":[100,20],"pos":[109,31],"locked":1,"show":"none","style":"check","value":1}
cd:{"type":"button","size":[100,20],"pos":[109,61],"locked":1,"show":"none","style":"check","value":0}

{script:wigglyPlayer.0p}
on frames do fr.images end
on order  do or.data end

on set_value x do
 if x.frames fr.images:x.frames..copy[] end
 or.data: (range count x.frames) unless x.order
end
on get_value do
 r.frames:frames[]
 r.order :order[]
 r
end

on view do
 f:frames[]
 o:order[]
 c.border:cbo.value
 c.show:card.show
 c.draggable:cd.value
 c.clear[]
 if count f
  i:f[o[(count o)%sys.frame/5]]
  i:if fl.value i.copy[].transform["horiz"] else i end
  if get_stretch[]
   c.paste[i 0,0,card.size]
  else
   c.paste[i .5*c.size-i.size]
  end
 end
end

on get_border do cbo.value end
on set_border x do c.border:x cbo.value:c.border end
on get_stretch do cst.value end
on set_stretch x do cst.value:x end
on get_frames do fr.value end
on set_frames x do fr.value:x end
on get_order_text do "," fuse order[] end
on set_order_text x do or.data: 0+"," split x end
on get_animate do view end
on get_flip do fl.value end
on set_flip x do fl.value:x end
on get_emotes do em.data end
on set_emotes x do em.data: x end
on set_emote x do or.data:() unless get_emotes[][x] end
on get_draggable do cd.value end
on set_draggable x do cd.value:x end

{end}

{script:wigglyPlayer.1p}
on click pos do
 card.event["click" pos]
end
on drag pos do
 if get_draggable[]
  card.pos:pos+(pointer.pos-pointer.start)
  me.pos:0,0
  card.event["drag" pos]
 end
end
on release pos do
 if get_draggable[]
  card.event["release" pos]
 end
end
{end}

{contraption:wigglyModal}
size:[512,342]
margin:[0,0,0,0]
description:"a full-featured wiggly image editor, designed to be overlaid on a card like a non-blocking modal dialog."
version:1.1
image:"%%"
script:"wigglyModal.0p"
template:"on finish do\n \nend"
attributes:{"name":[],"label":[],"type":[]}
{widgets}
zone:{"type":"button","size":[320,200],"pos":[52,63],"show":"none"}
done:{"type":"button","size":[74,43],"pos":[403,269],"script":"wigglyModal.1p","style":"invisible"}
clear:{"type":"button","size":[95,33],"pos":[29,273],"script":"wigglyModal.2p","style":"invisible"}
oops:{"type":"button","size":[72,50],"pos":[235,269],"script":"wigglyModal.3p","style":"invisible"}
crop:{"type":"button","size":[83,53],"pos":[147,267],"script":"wigglyModal.4p","show":"invert","style":"invisible"}
c:{"type":"canvas","size":[320,200],"pos":[52,63],"locked":1,"animated":1,"volatile":1,"brush":1,"scale":1}
fr:{"type":"field","size":[24,20],"pos":[49,25],"locked":1,"show":"none","value":{"text":["i","i","i"],"font":["","",""],"arg":["%%","%%","%%"]}}
hist:{"type":"field","size":[24,20],"pos":[81,25],"locked":1,"show":"none","value":{"text":["i","i","i"],"font":["","",""],"arg":["%%","%%","%%"]}}
sfx:{"type":"grid","size":[100,20],"pos":[114,25],"locked":1,"show":"none","format":"ss","value":{"name":["boom","pick","snap","cancel","scratch","click","wipe","wipe","wipe","stip","stip","stip","erase","erase","squeak","squeak","pencil","pencil","spray","spray","pen","pen"],"data":["%%","%%","%%","%%","%%","%%SND0Cu0S9vwL7xD3AAfyDPr+BvQH//sK9Af/9g7yC/3yE+4Q+vEX7RD49w/yDPn/BPkG/AAA/gE=","%%","%%","%%","%%","%%","%%","%%","%%","%%","%%","%%","%%","%%","%%","%%","%%"]}}
locks:{"type":"field","size":[24,20],"pos":[223,25],"locked":1,"show":"none"}
trans_mask:{"type":"canvas","size":[80,47],"pos":[314,264],"locked":1,"script":"wigglyModal.5p","show":"none","border":0,"image":"%%","scale":1}
trans:{"type":"button","size":[89,58],"pos":[311,264],"script":"wigglyModal.6p","font":"mono","show":"transparent","style":"invisible","value":0}
canv_pen:{"type":"canvas","size":[118,21],"pos":[374,56],"locked":1,"script":"wigglyModal.7p","show":"transparent","border":0,"image":"%%","scale":1}
canv_sumi:{"type":"canvas","size":[122,19],"pos":[388,77],"locked":1,"script":"wigglyModal.7p","show":"transparent","border":0,"image":"%%","scale":1}
canv_stipple:{"type":"canvas","size":[121,21],"pos":[388,96],"locked":1,"script":"wigglyModal.7p","show":"transparent","border":0,"image":"%%","scale":1}
canv_airbrush:{"type":"canvas","size":[122,35],"pos":[388,115],"locked":1,"script":"wigglyModal.7p","show":"transparent","border":0,"image":"%%","scale":1}
canv_pink:{"type":"canvas","size":[122,24],"pos":[388,149],"locked":1,"script":"wigglyModal.7p","show":"transparent","border":0,"image":"%%","scale":1}
canv_cyan:{"type":"canvas","size":[122,24],"pos":[388,173],"locked":1,"script":"wigglyModal.7p","show":"transparent","border":0,"image":"%%","scale":1}
canv_yellow:{"type":"canvas","size":[122,24],"pos":[388,197],"locked":1,"script":"wigglyModal.7p","show":"transparent","border":0,"image":"%%","scale":1}
canv_mask:{"type":"canvas","size":[122,24],"pos":[388,221],"locked":1,"script":"wigglyModal.7p","show":"transparent","border":0,"image":"%%","scale":1}
canv_eraser:{"type":"canvas","size":[112,21],"pos":[388,244],"locked":1,"script":"wigglyModal.7p","show":"transparent","border":0,"image":"%%","scale":1}

{script:wigglyModal.0p}
on get_animate do view end
on frames do fr.images end
REST:388
tc:canv_pen,canv_sumi,canv_stipple,canv_airbrush,canv_pink,canv_cyan,canv_yellow,canv_mask,canv_eraser
on toolval do
 5 drop first extract value..name,"canv_pen" where !REST=value..pos[0] from tc
end

on backup do hist.value:raze rtext.cat @ frames[]..copy[] end
delta:"%j"parse"[-2,-1,-1,0,1,1,2]"
marker:"%%IMG0ABUAFgD/gAP/wA//4B//8D//+H//+P//+P//+P//+P//+P//+P//+P//+P//8P//8P//4P//wH//gD//AB/+AAf8AAPgAA=="
on wiggle x do return random[delta  2]+x end
on get_init do
 on init do
  card.show:"transparent"
  locks.data:deck.card.widgets..locked
  deck.card.widgets..locked:1
 end
end
on cleanup do
 each v k in locks.data
  deck.card.widgets[k].locked:v
 end
 deck.remove[card]
end
on get_value do
 r.frames:frames[]
 r.order:range count r.frames
 r
end
on set_value x do
 if x.frames
  fr.images: x.frames..copy[]
 end
end
on audio x do
 if !app.playing
  play[sound[random[extract data where name=x from sfx.value]]]
 end
end

on drag x do
 fri:frames[]
 o:if pointer.down x else pointer.prev-c.offset end
 t:toolval[]
 on commonTool disp do
  c.brush:t
  each f in fri
   c.paste[f]
   c.line[disp[o] disp[x]]
   f.paste[c.copy[]]
  end
 end
 if t~"pen"
  audio.pen
  c.brush:1
  each f in fri
   c.paste[f]
   c.line[o random[-1,0,1 2]+x]
   f.paste[c.copy[]]
  end
 elseif t~"eraser"   audio.erase c.pattern:0 commonTool[on _ x do x end] c.pattern:1
 elseif t~"sumi"     audio.wipe  commonTool[wiggle]
 elseif t~"stipple"  audio.stip  commonTool[wiggle]
 elseif t~"airbrush" audio.spray commonTool[wiggle]
 else
  audio.squeak
  pat:("%j" parse "{l}'pink':36,'cyan':39,'yellow':33,'mask':32{r}")[t]
  img:image[marker].map[1,0]
  s:img.size
  y:x-s/2
  each f in fri
   w:wiggle[y]
   f.paste[img.copy[].merge[f.copy[w s].map[1 dict 1 pat]] w 1]
  end
 end
end
on click x do
 backup[]
 drag[x]
end

on view do
 f:frames[]
 i:f[(count f)%sys.frame/5]
 trans_mask.toggle["transparent" trans.value]
 c.show:if trans.value "transparent" else "solid" end
 c.size:i.size
 c.pos:zone.pos+.5*zone.size-c.size
 c.paste[i]
end

{end}

{script:wigglyModal.1p}
on click do
 audio.snap
 deck.card.event["finish_painting" get_value[]]
 cleanup[]
end
{end}

{script:wigglyModal.2p}
on oval pos size do
 flip pos+size*flip unit 2*pi*(range 20)/20
end

on shake obj tick do
  local st: 10 # time
  local sm: 15 # magnitude
  local sf:0.5 # fade
  local so:obj.pos
  while sm>0
    st:st-1
    obj.pos:so+random[sm,-sm 2]
    if st<0 sm:sm-sf end
    tick[]
  end
  obj.pos:so
end

on click do
 audio.boom
 backup[]
 trans.value:0
 c.show:"solid"
 local s:()
 shake[c on tick do
  c.pattern:0
  each v in s c.poly[v] end
  s:each _ in range 5
   oval[random[max c.size 2] 10+random[30]]
  end
  c.pattern:1
  each v in s c.poly[v] end
  sleep[]
 end]
 c.pattern:1
 fr.value:raze rtext.cat @ (3 take image[zone.size])..copy[]
end

{end}

{script:wigglyModal.3p}
on click do
 audio.erase
 t:hist.value
 hist.value:fr.value
 fr.value:t
end
{end}

{script:wigglyModal.4p}
on click do
 audio.scratch
 backup[]
 local f:first af:frames[]
 local b:f.bounds
 set_value[().frames:each f in af f.copy[b.pos b.size] end]
end
{end}

{script:wigglyModal.5p}
on click pos do end
on drag pos do end
on release pos do end
{end}

{script:wigglyModal.6p}
on click do
 audio.pick
 me.value:!me.value
 trans_mask.toggle["transparent" me.value]
end
{end}

{script:wigglyModal.7p}
tw:(list -12,-6,-2,0),(list -2,-6,-12,-14)
on click do
 p:REST=tc..pos[0]
 i:sum(me=tc)*range count tc
 if p[i]
  audio.pick
  each ai in range 4
   each t ti in tc
    off:if !p[ti]
     (-12,-6,-2,0)[ai]
    elseif t~me
     (-2,-6,-12,-14)[ai]
    end
    t.pos:(REST+off),t.pos[1]
   end
   sleep[]
  end
  if me~canv_mask trans.value:1 end
 end
end

on drag pos do end
on release pos do end
{end}

