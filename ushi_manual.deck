{script:card4.0}
on click do
o:()
 o.tfont:"sloppy2"
 o.align:"center"
dd.open[deck o]
 dd.say["ushi..."]
r:dd.ask[
 "...ror?"
 ("YES","NO","ushi")
]
if r~0
 dd.say["Hot...Hot..."]
elseif r~1
 dd.say["zzz"]
else
 dd.say["ushi!!!"]
end
dd.close[]
end
{end}

